# Fixtures are compared byte for byte by a test: never let git rewrite them, on any platform
# (core.autocrlf on Windows would otherwise turn LF into CRLF on checkout).
fixtures/** -text
*.pdf binary
*.xlsx binary
*.eml binary
# The runners write results with LF on every platform; check them out with LF too, so a rerun
# that reproduces a result leaves git status clean on Windows.
results/*.json text eol=lf
